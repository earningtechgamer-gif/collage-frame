<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Photo Collage</title>

<style>
body {
    margin: 0;
    background: linear-gradient(to bottom, #fceabb, #f8b500);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

/* Main Box */
.container {
    position: relative;
    width: 300px;
}

/* Photo Style */
.photo {
    width: 100%;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    margin-bottom: 15px;
}

/* Rotate Effect */
.rotate1 {
    transform: rotate(-5deg);
}
.rotate2 {
    transform: rotate(5deg)
      ;
  }
/* Music Card */
.music {
    position: absolute;
    top: 120px;
    left: 20px;
    background: #2c2c2c;
    color: white;
    padding: 10px;
    border-radius: 15px;
    width: 200px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.4);
}

/* Small Photo */
.small {
    position: absolute;
    bottom: -20px;
    right: -40px;
    width: 120px;
    border-radius: 15px;
}

/* Flower Decoration */
.flower {
    position: absolute;
    width: 50px;
}

.flower1 {
    top: -10px;
    left: -20px;
}
.flower2 {
    bottom: 10px;
    right: -10px;
}
</style>

</head>
<body>

<div class="container">
  <!-- Main Images -->
    <img src="image1.jpg" class="photo rotate1">
    <img src="image2.jpg" class="photo rotate2">
    <img src="image3.jpg" class="photo">

    <!-- Music Card -->
    <div class="music">
        <p>🎵 Mahoor</p>
        <audio controls>
            <source src="song.mp3" type="audio/mpeg">
        </audio>
    </div>

    <!-- Small Image -->
    <img src="image4.jpg" class="small">

    <!-- Flowers -->
    <img src="flower.png" class="flower flower1">
    <img src="flower.png" class="flower flower2">

</div>

</body>
</html>
